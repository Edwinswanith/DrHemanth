# Copy to .env.local for development. Never commit real values.
# See docs/12-data-processing-register.csv for the approval status of every
# third party referenced below. An unapproved variable must stay unset in
# production rather than filled with a placeholder that looks real.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Phase B/D: Neon Postgres, region eu-west-2/London) ---
# Status: pending — no production database provisioned yet.
DATABASE_URL=

# --- Notification provider (Phase B/D) ---
# Status: pending client approval. Do NOT default this to a real production
# provider. Leave unset to use the local dev/logging adapter.
# NOTIFICATION_PROVIDER=dev
NOTIFICATION_PROVIDER=dev
NOTIFICATION_FROM_ADDRESS=
NOTIFICATION_PRACTICE_RECIPIENT=

# --- Bot protection (Phase B: Cloudflare Turnstile, status: pending review) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting ---
# DB-backed by default; no separate vendor required.

# --- Analytics (only loaded post-consent; no PII ever sent) ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false
